<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../css/musiccatalog.css"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/20"
            fx:controller="coursework.musiccatalog.controller.MusicController">

    <top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <ImageView fx:id="logoImageView" fitHeight="30" fitWidth="30" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png" />
                </image>
            </ImageView>

            <Label styleClass="app-title" text="Music Catalog" />

            <Pane HBox.hgrow="ALWAYS" />

            <Button onAction="#minimizeWindow" styleClass="window-btn" text="—" />
            <Button onAction="#maximizeWindow" styleClass="window-btn" text="❐" />
            <Button onAction="#closeWindow" styleClass="window-btn" text="✕" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="albumTable">
            <columns>
                <TableColumn fx:id="titleColumn" text="Название" />
                <TableColumn fx:id="artistColumn" text="Артист" />
                <TableColumn fx:id="genreColumn" text="Жанр" />
                <TableColumn fx:id="releaseDateColumn" text="Дата релиза" />
                <TableColumn fx:id="statusColumn" text="Статус" />
                <TableColumn fx:id="typeColumn" text="Тип" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="bottom-bar" alignment="CENTER">

            <HBox spacing="15" alignment="CENTER">
                <Label text="Источник:" textFill="WHITE" />
                <ChoiceBox fx:id="sourceChoiceBox" />
                <Button onAction="#addAlbum" text="Добавить альбом" />
                <Button onAction="#deleteAlbum" text="Удалить альбом" />
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <TextField fx:id="filterGenreField" promptText="Название жанра" />
                <Button onAction="#filterByGenre" text="Применить фильтр" />
                <Button onAction="#sortByReleaseDate" text="Сортировать по дате" />
                <Label text="Десятилетие:" textFill="WHITE" />
                <ChoiceBox fx:id="decadeChoiceBox" />
                <Button onAction="#generatePlaylist" text="Сгенерировать плейлист" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
